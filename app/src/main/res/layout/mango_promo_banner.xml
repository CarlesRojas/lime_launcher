<?xml version="1.0" encoding="utf-8"?>
<!-- Heads the settings while Mango is not installed: a card in Mango's colours, so it never reads as one more row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background_mango_banner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="30dp"
            android:layout_marginEnd="14dp"
            android:contentDescription="@string/mango_promo_screenshot_description"
            android:src="@drawable/mango_shape" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat"
                android:text="@string/mango_banner_title"
                android:textColor="#FFB74D"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/mango_banner_subtitle"
                android:textColor="@color/white_low"
                android:textSize="14sp" />

            <!-- Lime PRO buyers only (MangoPromoPreference.isPro). -->
            <TextView
                android:id="@+id/mangoBanner_pro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/mango_banner_pro"
                android:textColor="#FFB74D"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@null"
            android:src="@drawable/icon_arrow_right"
            android:tint="#FFB74D" />
    </LinearLayout>
</LinearLayout>
